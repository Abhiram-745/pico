# Application binaries are published as GitHub Release assets, never committed:
# they are ~350 MB together and GitHub rejects any file over 100 MB in git.
*.exe
*.zip
*.filepart

# Build output
artifacts/
dist/
bin/
obj/

# Secrets — never commit. The repo is public.
.env
.env.*
!.env.example
*.key
*.pem

# Local state — never publish an audit log or a stored setting
audit.jsonl
settings.json

node_modules/
.DS_Store
Thumbs.db
*.log

# Stamped per build by CI; the local one is dev-only.
build.json

# Installed agent skills (tooling, not product code)
.agents/

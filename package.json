{
  "name": "halo",
  "private": true,
  "version": "0.2.0",
  "description": "Halo desktop agent — bridge and interface",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bridge/server.mjs",
    "build": "node scripts/build-site.mjs",
    "check": "node scripts/check.mjs",
    "check:desktop": "node scripts/test-desktop-monitor.mjs && node scripts/test-desktop-summary.mjs && node scripts/test-desktop-routes.mjs",
    "ui": "node scripts/build-ui.mjs",
    "ui:watch": "node scripts/build-ui.mjs --watch",
    "check:gemini": "node scripts/test-gemini.mjs",
    "check:providers": "node scripts/test-fallback.mjs",
    "check:composio": "node scripts/test-composio.mjs",
    "check:workspace": "node scripts/test-workspace-email-whatsapp.mjs && node scripts/test-workspace-cadence.mjs && node scripts/test-monitor-ingress.mjs"
  },
  "dependencies": {
    "@composio/core": "^0.28.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "border-beam": "^1.3.0",
    "bot-avatars": "^0.2.2",
    "esbuild": "^0.28.2",
    "jimp": "^0.22.10",
    "metal-fx": "^2.0.10",
    "node-screenshots": "^0.2.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "thinking-orbs": "^0.3.1"
  }
}

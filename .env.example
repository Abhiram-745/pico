# Copy to .env and paste your key. .env is gitignored and never committed.
#
# Only read by bridge/server.mjs, which runs on your own machine.
# It is never sent to the phone and never embedded in a page.

# --- OpenAI (default) ------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-paste-your-key-here

# Optional overrides. Defaults are the fastest sensible pair:
#   fast = gpt-5.4-nano   (low latency, used for most tasks)
#   hard = gpt-5.4-mini   (writing, comparison, multi-step work)
# PICO_MODEL_FAST=gpt-5.4-nano
# PICO_MODEL_HARD=gpt-5.4-mini

# --- BazaarLink (alternative) ---------------------------------------------
# An OpenAI-compatible gateway. Used automatically if no OPENAI_API_KEY is set.
# BAZAARLINK_API_KEY=sk-bl-...
# PICO_PROVIDER=bazaarlink

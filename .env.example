# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# BazaarLink is an OpenAI-compatible gateway: https://bazaarlink.ai
# Get a free key at https://bazaarlink.ai/free
#
# Read only by bridge/server.mjs, which runs on your own machine.
# It is never sent to the phone and never embedded in a page.

BAZAARLINK_API_KEY=sk-bl-your-key-here
BAZAARLINK_BASE_URL=https://api.bazaarlink.ai/v1

# "auto:free" routes to whichever free model is available.
PICO_MODEL=auto:free

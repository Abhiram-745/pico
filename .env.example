# Copy to .env and paste your key. .env is gitignored and never committed.
#
# Only read by bridge/server.mjs, which runs on your own machine.
# It is never sent to the phone and never embedded in a page.

# --- APINEX (used first when set) ------------------------------------------
# GPT-6 Luna, free. Key from https://apinex.bond/keys. Five requests a minute:
# past that, calls go to OpenAI, then xkiro, whichever keys are set below.
# APINEX_API_KEY=sk-apx...

# --- OpenAI ----------------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-paste-your-key-here

# Use one model for every language and vision decision.
PICO_MODEL=gpt-4o-mini
# Screenshots are read by gpt-4.1-mini: it bills a picture ~20x fewer tokens than gpt-4o-mini.
PICO_MODEL_SEE=gpt-4.1-mini

# --- BazaarLink (alternative) ---------------------------------------------
# An OpenAI-compatible gateway. Used automatically if no OPENAI_API_KEY is set.
# BAZAARLINK_API_KEY=sk-bl-...
# PICO_PROVIDER=bazaarlink

# Local ElevenLabs voice. Never put a real key in this template.
ELEVENLABS_API_KEY=
# Lowest latency for an interactive desktop assistant:
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Expressive alternative: eleven_v3_conversational
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

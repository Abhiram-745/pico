# Copy to .env only if you want to use your own key. .env is gitignored.
#
# Only read by bridge/server.mjs, which runs on your own machine.
# It is never sent to the phone and never embedded in a page.
#
# Halo runs every job on Qwen3.8 Omni Flash through xkiro
# (https://xkiro.com), an OpenAI-compatible gateway. A free shared key is
# built in, so nothing here is required.

# Your own xkiro key, in place of the shared one.
# XKIRO_API_KEY=sk-xt-...

# Optional: a different xkiro model for every job, or for one job.
# PICO_MODEL=qwen/qwen3.8-omni-flash:free
# PICO_MODEL_SEE=qwen/qwen3.8-omni-flash:free
